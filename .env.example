SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
DATABASE_URL=sqlite:///myduka.db
# DATABASE_URL=postgresql://user:password@localhost:5432/myduka
FRONTEND_URL=http://localhost:5173
# Comma-separated frontend origins permitted to call /api/*.
# Defaults to FRONTEND_URL when omitted.
CORS_ORIGINS=http://localhost:5173
INVITE_TOKEN_HOURS=48

# Leave MAIL_SERVER empty to log invite links instead of sending email
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@myduka.local
